{
  "name": "@schmooze/client",
  "version": "0.1.0",
  "description": "Minimal TypeScript client for the Schmooze app API (drogon, IAM, Firebase, OTEL)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test test/**/*.test.ts",
    "parse-har": "node scripts/parse-har.mjs",
    "example:login": "tsx examples/interactive-login.ts",
    "prebuild": "npm run parse-har"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "UNLICENSED",
  "private": true
}
